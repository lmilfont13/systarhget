# ============================================================================
# DOCFLOW-HUB - VARIÁVEIS DE AMBIENTE
# ============================================================================
# Cópia este arquivo para .env.local e preencha com seus valores reais
# IMPORTANTE: Nunca commite o arquivo .env com credenciais reais!
#

# ============================================================================
# SUPABASE - Configurações de banco de dados
# ============================================================================
# Obtenha estas chaves em: https://app.supabase.com/project/[projeto]/settings/api

# URL do seu projeto Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (anon) - SEGURA para usar no frontend
VITE_SUPABASE_ANON_KEY=sua-chave-publica-aqui

# Chave de serviço (secret) - MANTER SEGURA NO BACKEND APENAS
SUPABASE_SERVICE_ROLE_KEY=sua-chave-secreta-aqui

# ============================================================================
# AUTENTICAÇÃO - Promotores
# ============================================================================

# Senha padrão para acesso ao portal de promotores
VITE_PROMOTOR_PASSWORD=senha-promotor-padrao

# Email para alertas de segurança
VITE_SECURITY_EMAIL=seu-email@empresa.com

# ============================================================================
# API - Configurações gerais
# ============================================================================

# Ambiente: development, staging, production
VITE_APP_ENV=development

# URL da aplicação
VITE_APP_URL=http://localhost:5173

# Timeout para requisições (em ms)
VITE_API_TIMEOUT=30000

# ============================================================================
# PDF - Configurações de geração
# ============================================================================

# Qualidade dos PDFs gerados (low, medium, high)
VITE_PDF_QUALITY=high

# Caminho para salvar PDFs temporários
VITE_PDF_TEMP_PATH=./tmp/pdfs

# Limite de tamanho de arquivo (em MB)
VITE_MAX_FILE_SIZE=50

# ============================================================================
# SEGURANÇA
# ============================================================================

# Chave para hash de dados sensíveis
VITE_SECURITY_KEY=sua-chave-secreta-aqui

# Habilitar CORS (development only)
VITE_ENABLE_CORS=true

# ============================================================================
# LOGGING E MONITORAMENTO
# ============================================================================

# Nível de log: debug, info, warn, error
VITE_LOG_LEVEL=info

# Habilitar logs no console
VITE_LOG_CONSOLE=true

# URL para enviar logs (opcional)
VITE_LOG_ENDPOINT=

# ============================================================================
# EMAIL (Opcional - para notificações)
# ============================================================================

# Provedor de email: smtp, sendgrid, ses
EMAIL_PROVIDER=smtp

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-app

# SendGrid (alternativa)
SENDGRID_API_KEY=

# AWS SES (alternativa)
AWS_SES_REGION=

# ============================================================================
# NOTIFICAÇÕES
# ============================================================================

# Webhook do Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook do Slack (opcional)
SLACK_WEBHOOK_URL=

# ============================================================================
# DESENVOLVIMENTO
# ============================================================================

# Habilitar modo debug
DEBUG=false

# Habilitar hot reload
VITE_HMR_HOST=localhost
VITE_HMR_PROTOCOL=http

# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================
#
# 1. Chaves começadas com VITE_ são expostas no frontend (seguras de compartilhar)
# 2. Chaves sem VITE_ são apenas para backend (manter privadas)
# 3. Nunca commite .env com valores reais
# 4. Use .env.local para desenvolvimento
# 5. Use variáveis de ambiente do servidor para produção
# 6. Rotacione chaves regularmente
# 7. Monitore tentativas de acesso não autorizado
#
# ============================================================================
